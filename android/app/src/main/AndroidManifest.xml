<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
    <!-- 开机后重新排上保活闹钟：重启后系统不一定会重新绑定监听服务。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 后台常驻前台服务：进程优先级更高，不容易被系统回收。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14 起，前台服务必须声明具体类型；持续监听通知属于 specialUse。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13 起，常驻通知需要这个权限才能显示在通知栏。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Remember 记账"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data android:name="flutterEmbedding" android:value="2"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".PaymentNotificationListenerService"
            android:exported="true"
            android:label="支付通知监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!--
            后台常驻前台服务：让进程在被清理后还能被系统拉回来。
            这是「退到后台 / 被清理之后依旧能监听」的主力手段，
            START_STICKY 保证进程被回收后系统会重新启动它。
        -->
        <service
            android:name=".ListenerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续监听支付通知以实现后台自动记账"/>
        </service>

        <!-- 周期性的看门狗任务：进程被划掉后由系统重新调度，跨重启保留。 -->
        <service
            android:name=".ListenerWatchdogJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>

        <!--
            保活闹钟：每 15 分钟把进程拉起来请求系统重新绑定监听服务。
            监听服务被系统解绑后不会自己回来，这是唯一可靠的自动恢复途径。
        -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.remember_app.action.KEEP_ALIVE"/>
            </intent-filter>
        </receiver>

        <!-- 开机自启：重启后重新排闹钟并请求一次重绑。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <!-- 部分厂商的「快速启动」用这个动作代替 BOOT_COMPLETED。 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>